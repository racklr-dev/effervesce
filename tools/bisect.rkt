#lang racket
(require "../check/host-python.rkt" racklr/uir)
(define path (vector-ref (current-command-line-arguments) 0))
(define src (file->string path))
(define lines (regexp-split #rx"\n" src))
(define total (length lines))
(define (prefix-ok? nlines)
  (define prefix (string-join (take lines nlines) "\n"))
  (uir? (python-source->uir prefix)))
(if (prefix-ok? total)
    (printf "whole file parses OK (~a lines)\n" total)
    (let loop ([lo 0] [hi total])
      (if (> (- hi lo) 1)
          (let ([mid (quotient (+ lo hi) 2)])
            (if (prefix-ok? mid) (loop mid hi) (loop lo mid)))
          (begin
            (printf "first failing at ~a/~a lines\n" hi total)
            (for ([i (in-range (max 0 (- hi 3)) (min total (+ hi 2)))])
              (printf "~a: ~a\n" (+ i 1) (list-ref lines i)))))))
