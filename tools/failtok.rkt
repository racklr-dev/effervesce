#lang racket
(require "../check/host-python.rkt" racklr/uir)
(define path (vector-ref (current-command-line-arguments) 0))
(define src (file->string path))
(define tks (py-tokenize src))
(define eof (last tks))
(define body (drop-right tks 1))
(define total (length body))
(define (ok? n)
  (with-handlers ([exn:fail? (lambda (e) #f)])
    (define r (py-parse-file_input (append (take body n) (list eof)) 0))
    (and (list? r) (= (length r) 2))))
(if (ok? total)
    (printf "WHOLE OK (~a tokens)\n" total)
    (let loop ([lo 0] [hi total])
      (if (> (- hi lo) 1)
          (let ([mid (quotient (+ lo hi) 2)])
            (if (ok? mid) (loop mid hi) (loop lo mid)))
          (begin
            (printf "longest ok prefix: ~a/~a tokens; next tokens:\n" lo total)
            (for ([i (in-range lo (min total (+ lo 6)))])
              (define tk (list-ref body i))
              (printf "  [~a] ~a ~s\n" i (py-tok-type tk) (py-tok-value tk)))))))
