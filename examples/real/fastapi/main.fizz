// The FastAPI order service, described in Effervesce.
//
// The bridge checker infers the effects the Python code actually performs
// (db, llm, network, cache) and checks them against this component's needs,
// through the interpretation table:
//   Db    -> db       (SQLAlchemy session / sqlalchemy)
//   Llm   -> llm      (openai / anthropic / cohere)
//   Http  -> network  (httpx / requests / aiohttp)
//   Cache -> cache    (redis / memcache)
system FastApiOrders {

  capability Db {
    execute(sql: String) -> Unit
  }

  capability Llm {
    complete(prompt: String) -> String
  }

  capability Http {
    get(url: String) -> String
  }

  capability Cache {
    get(key: String) -> String
    set(key: String, value: String) -> Unit
  }

  given Db, Llm, Http, Cache

  component Api needs Db, Llm, Http, Cache {
    run() = execute("SELECT 1")
  }
}
